# Iron-Thread configuration.
#
# Everything is optional: with no .env file at all, Iron-Thread runs locally on SQLite.
# Copy this file to .env and UNCOMMENT only the lines you need. Every line below is commented out on
# purpose, so copying it can never switch on a setting by accident.

# Where the SQLite database lives (default: ironthread.db in the working directory)
# IRONTHREAD_DB=ironthread.db

# Signing key. By default a key file is created on first use. Back it up; never commit it.
# ATTEST_KEY_FILE=ironthread.key
# ATTEST_PRIVATE_KEY=            # the key itself (base64); overrides the file, for hosting
# ATTEST_RETIRED_PUBLIC_KEYS=    # comma-separated old public keys that stay trusted after a rotation

# API keys. Generate one with:  python auth.py
# With none set, only requests from this machine are accepted.
# IRONTHREAD_API_KEYS=
# IRONTHREAD_AUTH=off            # run fully open (trusted networks only)
# IRONTHREAD_CORS_ORIGINS=       # browser origins allowed to call the API, or *

# Auto-correction with Gemini
# GOOGLE_API_KEY=

# Optional legacy storage. If BOTH are set, Supabase is used instead of SQLite.
# SUPABASE_URL=
# SUPABASE_KEY=